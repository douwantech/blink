{
  "module": {
    "name": "pad",
    "type": "entry",
    "description": "Blink Pad — 平板大屏版",
    "mainElement": "PadAbility",
    "deviceTypes": ["tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "PadAbility",
        "srcEntry": "./ets/padability/PadAbility.ets",
        "description": "Blink Pad",
        "icon": "$media:layered_image",
        "label": "$string:pad_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 同手机版：长时任务保住主进程，VPN 扩展的生命周期挂在它上面
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "PadVpnAbility",
        "srcEntry": "./ets/vpnability/PadVpnAbility.ets",
        "description": "Tailscale VPN tunnel",
        "type": "vpn",
        "exported": false
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:perm_internet",
        "usedScene": { "abilities": ["PadVpnAbility"], "when": "always" }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:perm_netinfo",
        "usedScene": { "abilities": ["PadVpnAbility"], "when": "always" }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:perm_internet",
        "usedScene": { "abilities": ["PadAbility"], "when": "always" }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:perm_mic",
        "usedScene": { "abilities": ["PadAbility"], "when": "inuse" }
      }
    ]
  }
}
